<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Snapshot of the values the amortization schedule computed for a period payment rate change: the EIR of the
         segment the change opened plus the balance, discount, daily payment and term it re-amortizes. Nullable and
         not backfilled - rate changes booked before this were never given a snapshot, and it cannot be reconstructed
         from a schedule model that has since been rewritten. The EIR keeps 12 decimals because two rate changes only
         differ from the ninth decimal onwards. -->
    <changeSet author="fineract" id="wcl-0070-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="eir"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan_period_payment_rate_change">
            <column name="eir" type="DECIMAL(19,12)"/>
            <column name="calculated_annual_eir" type="DECIMAL(19,6)"/>
            <column name="net_disbursement_amount" type="DECIMAL(19,6)"/>
            <column name="discount_amount" type="DECIMAL(19,6)"/>
            <column name="daily_payment_amount" type="DECIMAL(19,6)"/>
            <column name="segment_total_days" type="INT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
